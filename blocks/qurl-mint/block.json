{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-qurl/mint",
	"version": "1.3.2",
	"title": "qURL Access Link",
	"category": "widgets",
	"icon": "admin-links",
	"description": "Let users or visitors generate a one-time qURL link to a configured endpoint.",
	"keywords": [ "qurl", "access", "secure", "link" ],
	"textdomain": "wp-qurl",
	"attributes": {
		"endpoint": {
			"type": "string",
			"default": ""
		},
		"buttonText": {
			"type": "string",
			"default": "Generate Access Link"
		},
		"successMessage": {
			"type": "string",
			"default": "Your one-time access link:"
		},
		"loginMessage": {
			"type": "string",
			"default": "Log in to generate your personal access link."
		},
		"allowVisitors": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "wp-qurl-block-editor",
	"viewScript": "wp-qurl-block-view",
	"style": "wp-qurl-block-view"
}
