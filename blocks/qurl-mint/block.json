{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-qurl/mint",
	"version": "1.3.2",
	"title": "Mint qURL",
	"category": "widgets",
	"icon": "admin-links",
	"description": "A button that makes a private qURL for a page.",
	"keywords": [ "qurl", "mint", "layerv", "secure", "link" ],
	"textdomain": "wp-qurl",
	"attributes": {
		"endpoint": {
			"type": "string",
			"default": ""
		},
		"buttonText": {
			"type": "string",
			"default": "Mint qURL"
		},
		"successMessage": {
			"type": "string",
			"default": "Your qURL:"
		},
		"loginMessage": {
			"type": "string",
			"default": "Log in to get your qURL."
		},
		"allowVisitors": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "wp-qurl-block-editor",
	"viewScript": "wp-qurl-block-view",
	"style": "wp-qurl-block-view"
}
